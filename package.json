{
  "name": "garment-factory-saas-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p typecheck build-only",
    "build-only": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build --force",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:codex": "node scripts/codex-test/run-all.mjs",
    "test:codex:preflight": "node scripts/codex-test/preflight.mjs",
    "test:codex:static": "run-p typecheck lint format:check",
    "test:codex:api": "node scripts/codex-test/api-contract.mjs",
    "test:codex:ui": "node scripts/codex-test/ui-e2e.mjs",
    "test:codex:modules": "playwright test e2e/all-modules-smoke.spec.ts --project=desktop-chromium",
    "test:codex:security": "node scripts/codex-test/security-smoke.mjs",
    "test:codex:perf": "node scripts/codex-test/perf-smoke.mjs",
    "test:e2e-launcher": "node --test e2e/support/e2e-launcher.test.mjs",
    "test:e2e-volume": "node --test e2e/support/e2e-volume-ownership.test.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write src tests e2e *.ts *.js *.json *.html",
    "format:check": "prettier --check src tests e2e *.ts *.js *.json *.html"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "axios": "1.19.0",
    "element-plus": "2.14.5",
    "pinia": "4.0.3",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tsconfig/node24": "24.0.4",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/compiler-sfc": "3.5.41",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.9.0",
    "eslint": "10.9.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "npm-run-all2": "8.0.4",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  }
}
